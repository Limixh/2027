{
  "name": "yks-2027-takip",
  "productName": "YKS 2027 Takip",
  "version": "1.9.1",
  "description": "YKS 2027 için çalışma takibi, deneme analizi, konu ilerlemesi ve yapay zeka koçu",
  "main": "./out/main/bootstrap.js",
  "author": "YKS 2027 Takip",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:win:portable": "npm run build && electron-builder --win portable --publish never",
    "update:bundle": "npm run build && node scripts/make-update.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/caveat": "^5.3.0",
